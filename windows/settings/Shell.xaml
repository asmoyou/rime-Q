<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rime Q 设置" Width="1000" Height="780" MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource TextColor}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#ECEEF2"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E1E4E9"/>
    <SolidColorBrush x:Key="TextColor" Color="#202124"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#77797F"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#D3E2F8"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#E5EBF5"/>
    <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextColor}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="MinWidth" Value="60"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextColor}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="24"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Border x:Name="Track" Height="22" Background="{DynamicResource BorderColor}" CornerRadius="11"/>
          <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" Stroke="#18000000" StrokeThickness="1" HorizontalAlignment="Left" Margin="2"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SkinChoice" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextColor}"/><Setter Property="Margin" Value="0,6"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextColor}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextColor}"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Drop" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="10,3,24,3" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Path Data="M 0,0 L 3,3 L 6,0" Stroke="{DynamicResource SecondaryColor}" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5" Padding="3">
              <ScrollViewer CanContentScroll="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Drop" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
      <Setter Property="RowBackground" Value="{DynamicResource CardBackground}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource WindowBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SidebarBackground}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryColor}"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource WindowBackground}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,26,12,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,28">
          <Image x:Name="BrandIcon" Width="34" Height="34" Margin="0,0,10,0"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="Rime Q" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="输入法设置" FontSize="11" Foreground="{DynamicResource SecondaryColor}" Margin="0,2,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel x:Name="Footer" DockPanel.Dock="Bottom"/>
        <StackPanel x:Name="Navigation"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,28,28,24">
        <StackPanel>
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="PageTitle" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" FontSize="13" Foreground="{DynamicResource SecondaryColor}" Margin="0,7,18,0" TextWrapping="Wrap"/></StackPanel>
            <StackPanel x:Name="PageAction" Grid.Column="1" VerticalAlignment="Top" Margin="0,2,0,0"/>
          </Grid>
          <StackPanel x:Name="Page"/>
        </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="Status" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryColor}" Margin="28,0,28,12" FontSize="12" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
