#!/bin/bash
set -eu

APP="/Library/Input Methods/RimeQ.app"
IDENTIFIER="com.asmoyou.inputmethod.RimeQ"
RIMEQ_SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
. "$RIMEQ_SCRIPT_DIR/version-check.sh"
package_version=$(/usr/libexec/PlistBuddy -c 'Print :Version' "$RIMEQ_SCRIPT_DIR/package-version.plist")
package_build=$(/usr/libexec/PlistBuddy -c 'Print :Build' "$RIMEQ_SCRIPT_DIR/package-version.plist")
installed_version=''
installed_build=''
if [ "${3:-/}" != "/" ]; then
    echo "Rime Q: install on the current startup volume."
    exit 1
fi
if [ -L "$APP" ]; then
    echo "Rime Q: the installation path must not be a symbolic link."
    exit 1
fi
if [ -e "$APP" ]; then
    installed_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP/Contents/Info.plist" 2>/dev/null || true)
    if [ "$installed_id" != "$IDENTIFIER" ]; then
        echo "Rime Q: another application occupies $APP."
        exit 1
    fi
    installed_version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP/Contents/Info.plist")
    installed_build=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$APP/Contents/Info.plist")
    if [ -z "$installed_version" ] || [ -z "$installed_build" ]; then
        echo 'Rime Q: 已有应用缺少版本信息，未修改应用。'
        exit 1
    fi
fi
if ! install_action=$(rimeq_install_action "$installed_version" "$installed_build" "$package_version" "$package_build"); then
    echo 'Rime Q: 无法确认已安装版本，未修改应用。'
    exit 1
fi
if [ "$install_action" = downgrade ]; then
    echo "Rime Q: 已安装 $installed_version ($installed_build)，拒绝用 $package_version ($package_build) 覆盖较新版本。"
    exit 1
fi
echo "Rime Q: $install_action ${installed_version:-none} ($installed_build) -> $package_version ($package_build); personal data retained."

check_duplicates() {
    local directory="$1" candidate candidate_id
    for candidate in "$directory"/*.app; do
        [ "$candidate" != "$APP" ] || continue
        [ -e "$candidate/Contents/Info.plist" ] || continue
        candidate_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$candidate/Contents/Info.plist" 2>/dev/null || true)
        if [ "$candidate_id" = "$IDENTIFIER" ]; then
            echo "Rime Q: remove the other application copy before installing: $candidate. Keep personal dictionaries."
            exit 1
        fi
    done
}
check_duplicates "/Library/Input Methods"
console_user=$(/usr/bin/stat -f '%Su' /dev/console)
case "$console_user" in
    root|loginwindow|_mbsetupuser) ;;
    *)
        user_directory=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')
        [ -n "$user_directory" ] || exit 1
        check_duplicates "$user_directory/Library/Input Methods"
        console_uid=$(/usr/bin/id -u "$console_user")
        as_login_user() {
            /bin/launchctl asuser "$console_uid" /usr/bin/sudo -H -u "$console_user" -- /usr/bin/env -i "$@"
        }
        if [ "$(as_login_user /usr/bin/defaults read "$IDENTIFIER" sentenceOptimization 2>/dev/null || true)" = 1 ]; then
            . "$RIMEQ_SCRIPT_DIR/preserve-model.sh"
            model_hash=$(/usr/libexec/PlistBuddy -c 'Print :SHA256' "$RIMEQ_SCRIPT_DIR/model-info.plist")
            preserve_rimeq_model "$APP/Contents/SharedSupport/wanxiang-lts-zh-hans.gram" \
                "$user_directory/Library/Application Support/RimeQ/models" "$model_hash"
        fi
        ;;
esac
