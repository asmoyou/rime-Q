#!/bin/bash
set -eu

APP="/Library/Input Methods/RimeQ.app"
EXE="$APP/Contents/MacOS/RimeQ"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
RIMEQ_SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
package_version=$(/usr/libexec/PlistBuddy -c 'Print :Version' "$RIMEQ_SCRIPT_DIR/package-version.plist")
package_build=$(/usr/libexec/PlistBuddy -c 'Print :Build' "$RIMEQ_SCRIPT_DIR/package-version.plist")
[ -x "$EXE" ]
[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP/Contents/Info.plist")" = "com.asmoyou.inputmethod.RimeQ" ]
if [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP/Contents/Info.plist")" != "$package_version" ] \
    || [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$APP/Contents/Info.plist")" != "$package_build" ]; then
    echo "Rime Q: installed version does not match package $package_version ($package_build)."
    exit 1
fi
/usr/bin/codesign --verify --deep --strict "$APP"
echo "Rime Q: verified installed application at $APP."

console_user=$(/usr/bin/stat -f '%Su' /dev/console)
case "$console_user" in
    root|loginwindow|_mbsetupuser)
        echo "Rime Q: no active login user; add Rime Q in Keyboard settings after login."
        exit 0
        ;;
esac
console_uid=$(/usr/bin/id -u "$console_user")
# asuser sets the GUI bootstrap session; sudo also drops root to the login UID.
as_login_user() {
    /bin/launchctl asuser "$console_uid" /usr/bin/sudo -H -u "$console_user" -- /usr/bin/env -i "$@"
}
as_login_user "$LSREGISTER" -f "$APP"
# LaunchServices must launch the GUI user's application. Calling its executable
# directly from this package script can return successful TIS calls without
# actually enabling the source. The app verifies and presents the real result.
as_login_user /usr/bin/open -n -g "$APP" --args --complete-install
echo "Rime Q: application installed; activation continues in the user session. A prompt appears only if action is needed."
